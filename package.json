{
  "name": "quotes",
  "type": "module",
  "version": "1.0.0",
  "description": "A modern, minimalist Twitter-style quotes curation static site built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "new": "node scripts/new-quote.mjs",
    "sync:twitter": "node scripts/sync-twitter.mjs",
    "docker:build": "docker build -t quotes .",
    "docker:run": "docker run -d -p 8080:80 --name quotes quotes",
    "docker:compose": "docker compose up -d --build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "latest",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3"
  }
}
