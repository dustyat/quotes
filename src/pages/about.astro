---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@/utils/config';
---

<BaseLayout 
  title="关于本站" 
  description={SITE_CONFIG.description}
  pageHeaderTitle="关于本站"
>
  <div class="about-page">
    <div class="about-hero">
      <h2 class="about-title">{SITE_CONFIG.title}</h2>
      <p class="about-desc">{SITE_CONFIG.description}</p>
    </div>

    <div class="about-section">
      <h3 class="section-title">空间初衷</h3>
      <p class="section-text">
        在这个注意力碎片化、算法推荐泛滥的时代，我们每天被数以万计的信息噪音淹没。<strong>Quotes</strong> 旨在建立一个纯粹、安静、经得起时间检验的智者语录时间轴。
      </p>
      <p class="section-text">
        这里不生产冗长的长篇大论，只沉淀那些来自先贤、智者、经典书籍与前沿思想中的璀璨字句、思维模型与顿悟时刻。
      </p>
    </div>

    <div class="about-section">
      <h3 class="section-title">核心特性与美学</h3>
      <div class="tech-features-grid">
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <div class="feature-content">
            <h4 class="feature-title">纯静态极速生成</h4>
            <p class="feature-desc">基于最新 Astro 5+ 架构静态渲染，0 客户端 JS 运行时负担，秒级首屏响应，全球 CDN 边缘极速分发。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🎲</div>
          <div class="feature-content">
            <h4 class="feature-title">灵感漫步与随机卡片</h4>
            <p class="feature-desc">顶部内置精选随机金句卡片，支持客户端毫秒级免刷新「换一换」，在经典思想流中偶遇顿悟。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🌿</div>
          <div class="feature-content">
            <h4 class="feature-title">通透极简时间轴</h4>
            <p class="feature-desc">去除所有多余边框与卡片阴影，1px 细化淡雅轴线，心情表情与首行文字精准水平居中对齐。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🖼️</div>
          <div class="feature-content">
            <h4 class="feature-title">极简金句海报引擎</h4>
            <p class="feature-desc">内置纯前端 Canvas 引擎，生成极简排版金句图，右下角纯色二维码自适应反色，可直接保存与溯源。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">📤</div>
          <div class="feature-content">
            <h4 class="feature-title">全端便捷社交分享</h4>
            <p class="feature-desc">支持一键分享至 X (Twitter) 与 Facebook；移动端优先唤起原生系统分享，PC 端快速复制追溯链接。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <div class="feature-content">
            <h4 class="feature-title">原生多语言与智能感知</h4>
            <p class="feature-desc">内置中、英、日、韩、越五国语种体系，首次访问智能感知系统语言，卡片与海报均支持一键即时切换。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🤖</div>
          <div class="feature-content">
            <h4 class="feature-title">Gemini 云端自动翻译</h4>
            <p class="feature-desc">创作者仅需发布中文，GitHub Actions 联动 Google Gemini Pro 自动补齐四国文学级译文并构建上线。</p>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">📡</div>
          <div class="feature-content">
            <h4 class="feature-title">AI-Ready 与开放生态</h4>
            <p class="feature-desc">遵循 <code>/llms.txt</code> 规范与 Schema.org 结构化数据，提供静态 JSON API 与 RSS 2.0 订阅。</p>
          </div>
        </div>
      </div>
    </div>

    <div class="about-section">
      <h3 class="section-title">订阅与开放接口</h3>
      <div class="open-links-grid">
        <a href="/rss.xml" target="_blank" class="open-link-card">
          <svg class="open-link-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          <div>
            <div class="link-title">RSS 2.0 订阅</div>
            <div class="link-sub">在阅读器中同步更新最新金句</div>
          </div>
        </a>

        <a href="/llms.txt" target="_blank" class="open-link-card">
          <svg class="open-link-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path></svg>
          <div>
            <div class="link-title">AI / llms.txt</div>
            <div class="link-sub">为 LLM 提供结构化语义索引</div>
          </div>
        </a>

        <a href="/api/memos.json" target="_blank" class="open-link-card">
          <svg class="open-link-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          <div>
            <div class="link-title">JSON 开放接口</div>
            <div class="link-sub">纯静态 REST 数据端点</div>
          </div>
        </a>

        <a href="https://github.com/dustyat/quotes" target="_blank" rel="noopener noreferrer" class="open-link-card">
          <svg class="open-link-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          <div>
            <div class="link-title">GitHub 源码</div>
            <div class="link-sub">基于 Astro 的开源金句系统</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 24px 0 40px 0;
  }
  .about-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border-color);
  }
  .about-title {
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .about-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 520px;
    margin-top: 12px;
    line-height: 1.6;
  }

  .about-section {
    padding-top: 28px;
  }
  .section-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }
  .section-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 12px;
  }
  .section-text strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* 特性列表：极简现代无外框无背景 */
  .tech-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px 24px;
    margin-top: 14px;
  }
  .feature-card {
    display: flex;
    gap: 12px;
    padding: 4px 0;
    background: transparent;
    border: none;
    border-radius: 0;
  }
  .feature-icon {
    font-size: 1.25rem;
    line-height: 1.3;
    flex-shrink: 0;
  }
  .feature-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .feature-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* 开放链接：极简现代无外框无背景 */
  .open-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 14px;
  }
  .open-link-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    background: transparent;
    border: none;
    border-radius: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .open-link-card:hover {
    opacity: 0.75;
    transform: translateX(3px);
    background: transparent;
  }
  .open-link-icon {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }
  .open-link-card:hover .open-link-icon {
    color: var(--text-primary);
  }
  .link-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .link-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  @media (max-width: 640px) {
    .tech-features-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .open-links-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
