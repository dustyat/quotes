---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteCard from '@/components/QuoteCard.astro';
import RandomFeaturedQuote from '@/components/RandomFeaturedQuote.astro';
import { SITE_CONFIG } from '@/utils/config';

const allMemos = await getCollection('memos');

// 下方时间轴恢复自然时间倒序排列
const sortedMemos = allMemos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <!-- 顶部特色展区：居中的 Quotes 品牌与随机卡片，以纯色浅色系随机背景填充 -->
  {allMemos.length > 0 && (
    <section class="hero-featured-box" id="hero-featured-box">
      <div class="hero-brand-header">
        <h1 class="headline-title">{SITE_CONFIG.title}</h1>
      </div>

      <RandomFeaturedQuote memos={allMemos} isFirst={true} />
    </section>
  )}

  <!-- 金句流 -->
  <section class="quotes-stream">
    {sortedMemos.length === 0 ? (
      <div class="empty-state">
        <p>暂无金句，请通过 <code>npm run new</code> 发布第一条！</p>
      </div>
    ) : (
      sortedMemos.map(async (memo, index) => {
        const { Content } = await render(memo);
        const memoId = memo.id.replace(/\.md$/, '');
        return (
          <QuoteCard 
            id={memoId} 
            body={memo.body || ''} 
            data={memo.data}
            isFirst={index === 0}
            isLast={index === sortedMemos.length - 1}
          >
            <Content />
          </QuoteCard>
        );
      })
    )}
  </section>
</BaseLayout>

<style>
  .hero-featured-box {
    background: var(--hero-bg, #faf4eb);
    border: 1px solid var(--hero-border, #efe3d2);
    border-radius: 24px;
    padding: 52px 36px 32px 36px;
    margin-top: 24px;
    margin-bottom: 56px;
    transition: background-color 0.45s ease, border-color 0.45s ease;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
  }

  :global([data-theme="dark"]) .hero-featured-box {
    background: var(--hero-bg-dark, #231e17);
    border-color: var(--hero-border-dark, rgba(255, 255, 255, 0.08));
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.3);
  }

  .hero-brand-header {
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 4px;
    margin-bottom: 40px;
  }

  .headline-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .quotes-stream {
    display: flex;
    flex-direction: column;
    padding-top: 8px;
  }

  .empty-state {
    padding: 80px 24px;
    text-align: center;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }
  .empty-state code {
    background: var(--badge-bg);
    padding: 4px 8px;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .hero-featured-box {
      border-radius: 18px;
      padding: 36px 20px 24px 20px;
      margin-top: 16px;
      margin-bottom: 40px;
    }
    .hero-brand-header {
      margin-bottom: 28px;
    }
    .headline-title {
      font-size: 2rem;
    }
    .quotes-stream {
      padding-top: 4px;
    }
  }
</style>
