---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteCard from '@/components/QuoteCard.astro';
import { type Locale, useTranslations } from '@/i18n/ui';

export async function getStaticPaths() {
  const allMemos = await getCollection('memos');
  const uniqueTags = [...new Set(allMemos.flatMap((memo) => memo.data.tags || []))];
  const langs = ['en', 'ja', 'ko', 'vi'];
  const paths = [];

  for (const lang of langs) {
    for (const tag of uniqueTags) {
      const filteredMemos = allMemos.filter((memo) => memo.data.tags?.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
      paths.push({
        params: { lang, tag },
        props: { memos: filteredMemos, lang },
      });
    }
  }

  return paths;
}

const { tag } = Astro.params;
const { memos, lang } = Astro.props as { memos: any[]; lang: Locale };
const t = useTranslations(lang);
---

<BaseLayout 
  title={`#${tag} - ${t('site.title')}`} 
  description={`${t('tags.desc')}: #${tag}`}
  locale={lang}
>
  <div class="tag-page-header">
    <div class="tag-badge-large">#{tag}</div>
    <p class="tag-count-text">{memos.length} {t('search.count')}</p>
  </div>

  <section class="quotes-stream">
    {memos.map(async (memo, index) => {
      const { Content } = await render(memo);
      const memoId = memo.id.replace(/\.md$/, '');
      return (
        <QuoteCard 
          id={memoId} 
          body={memo.body || ''} 
          data={memo.data}
          isFirst={index === 0}
          isLast={index === memos.length - 1}
          locale={lang}
        >
          <Content />
        </QuoteCard>
      );
    })}
  </section>
</BaseLayout>

<style>
  .tag-page-header {
    padding: 32px 0 24px 0;
    margin-bottom: 12px;
  }
  .tag-badge-large {
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .tag-count-text {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .quotes-stream {
    display: flex;
    flex-direction: column;
  }
</style>
