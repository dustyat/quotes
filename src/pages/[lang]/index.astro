---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteCard from '@/components/QuoteCard.astro';
import RandomFeaturedQuote from '@/components/RandomFeaturedQuote.astro';
import { SITE_CONFIG } from '@/utils/config';
import { type Locale, useTranslations } from '@/i18n/ui';
import { PAGE_SIZE } from '../partials/feed/[...slug].astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'vi' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const allMemos = await getCollection('memos');
const sortedMemos = allMemos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 首屏极速直出前 PAGE_SIZE 条，后续无感流式惰性加载
const initialMemos = sortedMemos.slice(0, PAGE_SIZE);
const totalMemos = sortedMemos.length;
const totalPages = Math.ceil(totalMemos / PAGE_SIZE);
---

<BaseLayout title={SITE_CONFIG.title} description={t('site.description')} locale={lang}>
  <!-- 顶部特色展区：居中的 Quotes 品牌与随机卡片，以纯色浅色系随机背景填充 -->
  {allMemos.length > 0 && (
    <section class="hero-featured-box" id="hero-featured-box">
      <div class="hero-brand-header">
        <h1 class="headline-title">{SITE_CONFIG.title}</h1>
      </div>

      <RandomFeaturedQuote memos={allMemos} isFirst={true} locale={lang} />
    </section>
  )}

  <!-- 金句流 -->
  <section class="quotes-stream" id="quotes-stream">
    {sortedMemos.length === 0 ? (
      <div class="empty-state">
        <p>{t('feed.empty')}</p>
      </div>
    ) : (
      initialMemos.map(async (memo, index) => {
        const { Content } = await render(memo);
        const memoId = memo.id.replace(/\.md$/, '');
        return (
          <QuoteCard 
            id={memoId} 
            body={memo.body || ''} 
            data={memo.data}
            isFirst={index === 0}
            isLast={index === totalMemos - 1}
            locale={lang}
          >
            <Content />
          </QuoteCard>
        );
      })
    )}

    {totalPages > 1 && (
      <div 
        id="stream-sentinel" 
        class="stream-sentinel" 
        data-next-page="2" 
        data-total-pages={totalPages} 
        data-locale={lang}
      >
        <div class="stream-loading" id="stream-loading">
          <div class="loading-pulse-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="loading-text">{t('feed.loadingMore')}</span>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<script is:inline>
  (function() {
    const sentinel = document.getElementById('stream-sentinel');
    const loading = document.getElementById('stream-loading');
    if (!sentinel) return;

    let nextPage = 2;
    const totalPages = parseInt(sentinel.getAttribute('data-total-pages') || '1', 10);
    const locale = sentinel.getAttribute('data-locale') || 'zh';
    let isLoading = false;

    async function loadNextBatch() {
      if (isLoading || nextPage > totalPages) return;
      isLoading = true;
      if (loading) loading.style.opacity = '1';

      try {
        const slug = locale === 'zh' ? `${nextPage}` : `${locale}/${nextPage}`;
        const res = await fetch(`/partials/feed/${slug}/`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const html = await res.text();

        const temp = document.createElement('div');
        temp.innerHTML = html;

        const rows = Array.from(temp.children);
        rows.forEach((row, i) => {
          row.classList.add('stream-item-enter');
          row.style.animationDelay = `${i * 35}ms`;
          sentinel.parentNode.insertBefore(row, sentinel);
        });

        nextPage++;

        if (nextPage > totalPages) {
          sentinel.remove();
          observer.disconnect();
        }
      } catch (err) {
        console.error('Failed to load next feed batch', err);
      } finally {
        isLoading = false;
      }
    }

    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && !isLoading && nextPage <= totalPages) {
        loadNextBatch();
      }
    }, {
      rootMargin: '450px 0px',
    });

    observer.observe(sentinel);
  })();
</script>

<style>
  .hero-featured-box {
    background: var(--hero-bg, #faf4eb);
    border: 1px solid var(--hero-border, #efe3d2);
    border-radius: 24px;
    padding: 52px 36px 32px 36px;
    margin-top: 24px;
    margin-bottom: 56px;
    transition: background-color 0.45s ease, border-color 0.45s ease;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
  }

  :global([data-theme="dark"]) .hero-featured-box {
    background: var(--hero-bg-dark, #231e17);
    border-color: var(--hero-border-dark, rgba(255, 255, 255, 0.08));
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.3);
  }

  .hero-brand-header {
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 4px;
    margin-bottom: 40px;
  }

  .headline-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-primary);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .quotes-stream {
    display: flex;
    flex-direction: column;
    padding-top: 8px;
  }

  .empty-state {
    padding: 80px 24px;
    text-align: center;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }
  .empty-state code {
    background: var(--badge-bg);
    padding: 4px 8px;
    border-radius: 4px;
  }

  /* 流式加载哨兵与微光动效 */
  .stream-sentinel {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 0 36px 0;
  }

  .stream-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .loading-pulse-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .loading-pulse-dots span {
    width: 6px;
    height: 6px;
    background: var(--text-muted);
    border-radius: 50%;
    opacity: 0.3;
    animation: pulseDot 1.4s infinite ease-in-out both;
  }

  .loading-pulse-dots span:nth-child(1) {
    animation-delay: -0.32s;
  }
  .loading-pulse-dots span:nth-child(2) {
    animation-delay: -0.16s;
  }

  @keyframes pulseDot {
    0%, 80%, 100% {
      transform: scale(0.7);
      opacity: 0.25;
    }
    40% {
      transform: scale(1.2);
      opacity: 1;
      background: var(--accent);
    }
  }

  .loading-text {
    font-size: 0.8125rem;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  /* 新卡片平滑滑入动效 */
  :global(.stream-item-enter) {
    animation: streamFadeInUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes streamFadeInUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .hero-featured-box {
      border-radius: 18px;
      padding: 36px 20px 24px 20px;
      margin-top: 16px;
      margin-bottom: 40px;
    }
    .hero-brand-header {
      margin-bottom: 28px;
    }
    .headline-title {
      font-size: 2rem;
    }
    .quotes-stream {
      padding-top: 4px;
    }
  }
</style>
