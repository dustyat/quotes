---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteCard from '@/components/QuoteCard.astro';
import { toIsoString } from '@/utils/date';
import { type Locale, useTranslations, LOCALES } from '@/i18n/ui';

export async function getStaticPaths() {
  const memos = await getCollection('memos');
  const langs = ['en', 'ja', 'ko', 'vi'];
  const paths = [];

  for (const lang of langs) {
    for (const memo of memos) {
      const memoId = memo.id.replace(/\.md$/, '');
      paths.push({
        params: { lang, id: memoId },
        props: { memo, memoId, lang },
      });
    }
  }

  return paths;
}

const { memo, memoId, lang } = Astro.props as { memo: any; memoId: string; lang: Locale };
const t = useTranslations(lang);
const { Content } = await render(memo);

const translations = memo.data.translations || {};
const contentText = (translations[lang]?.content) || memo.body || '';
const plainText = contentText.replace(/[\n#*`_]/g, ' ').trim().slice(0, 120);
const backUrl = LOCALES[lang]?.prefix || '/';
---

<BaseLayout
  title={`“${plainText}...”`}
  description={contentText}
  type="quote"
  datePublished={toIsoString(memo.data.date)}
  tags={memo.data.tags}
  locale={lang}
>
  <div class="memo-detail-wrapper">
    <div class="back-nav-bar">
      <a href={backUrl} class="back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{t('nav.quotes')}</span>
      </a>
    </div>

    <QuoteCard id={memoId} body={memo.body || ''} data={memo.data} locale={lang}>
      <Content />
    </QuoteCard>
  </div>
</BaseLayout>

<style>
  .memo-detail-wrapper {
    padding: 32px 0 24px 0;
  }
  .back-nav-bar {
    margin-bottom: 16px;
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }
  .back-btn:hover {
    color: var(--accent);
  }
</style>
