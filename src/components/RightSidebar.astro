---
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '@/utils/config';
import TagBadge from './TagBadge.astro';

const allMemos = await getCollection('memos');

// 统计热门标签与出现次数
const tagCounts = allMemos.reduce((acc, memo) => {
  (memo.data.tags || []).forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<aside class="right-sidebar">
  <div class="sidebar-sticky-wrapper">
    <!-- 搜索框触发器 -->
    <div class="search-trigger-box" id="sidebar-search-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span>搜索金句 / 标签...</span>
      <kbd>⌘K</kbd>
    </div>

    <!-- 热门话题 -->
    <div class="widget-card">
      <h3 class="widget-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
          <path d="M7 7h.01"></path>
        </svg>
        <span>热门话题</span>
      </h3>
      <div class="tags-cloud">
        {sortedTags.map(([tag, count]) => (
          <TagBadge tag={tag} count={count} />
        ))}
      </div>
    </div>

    <!-- AI & 开放生态 -->
    <div class="widget-card ai-widget">
      <div class="ai-header">
        <div class="ai-badge">AI Ready</div>
        <h4 class="ai-title">2026 AI 友好语料</h4>
      </div>
      <p class="ai-desc">
        本站内容遵循 <code>/llms.txt</code> 规范，提供纯静态开放数据接口供大模型检索与引用。
      </p>
      <div class="ai-links">
        <a href="/llms.txt" target="_blank" class="ai-link">
          <span>查看 llms.txt</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
        <a href="/api/memos.json" target="_blank" class="ai-link">
          <span>JSON API</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="footer-info">
      <p>{SITE_CONFIG.slogan}</p>
      <p class="copyright">© 2026 {SITE_CONFIG.author.name} · Built with Astro</p>
    </div>
  </div>
</aside>

<style>
  .right-sidebar {
    padding: 24px 0;
  }
  .sidebar-sticky-wrapper {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .search-trigger-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .search-trigger-box:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }
  .search-trigger-box span {
    flex: 1;
  }
  .search-trigger-box kbd {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .widget-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 16px;
  }
  .widget-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-widget {
    background: linear-gradient(135deg, var(--bg-secondary), var(--accent-light));
    border-color: var(--accent-glow);
  }
  .ai-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .ai-badge {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .ai-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .ai-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .ai-links {
    display: flex;
    gap: 8px;
  }
  .ai-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    padding: 4px 8px;
    background: var(--bg-card);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }
  .ai-link:hover {
    border-color: var(--accent);
  }

  .footer-info {
    padding: 0 4px;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>

<script is:inline>
  document.getElementById('sidebar-search-btn')?.addEventListener('click', () => {
    if (typeof window.openSearchModal === 'function') {
      window.openSearchModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (typeof window.openSearchModal === 'function') {
        window.openSearchModal();
      }
    }
  });
</script>
