<div id="wechat-modal" class="wechat-modal-overlay" aria-hidden="true">
  <div class="wechat-modal-container">
    <div class="wechat-modal-header">
      <div class="header-title-group">
        <svg class="wechat-header-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8.691 2.188C3.891 2.188 0 5.478 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.294.295a.34.34 0 0 0 .171-.05l1.92-1.077a.71.71 0 0 1 .59-.064c1.026.31 2.146.48 3.327.48.337 0 .668-.018.995-.045-.213-.655-.333-1.353-.333-2.08 0-4.047 3.864-7.332 8.655-7.332.32 0 .633.018.944.043C16.892 4.417 13.088 2.188 8.69 2.188zm-2.48 4.22c.62 0 1.12.5 1.12 1.119 0 .62-.5 1.12-1.12 1.12-.619 0-1.12-.5-1.12-1.12 0-.619.501-1.12 1.12-1.12zm5.58 0c.619 0 1.12.5 1.12 1.119 0 .62-.501 1.12-1.12 1.12-.62 0-1.12-.5-1.12-1.12 0-.619.5-1.12 1.12-1.12zm5.271 4.544c-3.992 0-7.243 2.742-7.243 6.126 0 3.383 3.251 6.125 7.243 6.125.857 0 1.677-.128 2.434-.36a.6.6 0 0 1 .5.053l1.602.9a.28.28 0 0 0 .143.042c.137 0 .245-.11.245-.246 0-.06-.024-.12-.04-.177l-.326-1.236a.49.49 0 0 1 .178-.555c1.528-1.124 2.508-2.784 2.508-4.63 0-3.384-3.251-6.126-7.244-6.126zm-2.07 3.518c.516 0 .933.417.933.933s-.417.933-.933.933c-.515 0-.933-.417-.933-.933s.418-.933.933-.933zm4.653 0c.516 0 .933.417.933.933s-.417.933-.933.933c-.516 0-.933-.417-.933-.933s.417-.933.933-.933z"/>
        </svg>
        <h3 class="modal-title">分享到微信朋友圈</h3>
      </div>
      <button id="close-wechat-btn" class="close-btn" aria-label="关闭">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="wechat-modal-body">
      <div class="qr-canvas-box">
        <canvas id="wechat-qr-canvas" width="200" height="200"></canvas>
      </div>
      <div class="wechat-instructions">
        <p class="instruction-main">使用微信「扫一扫」</p>
        <p class="instruction-sub">打开页面后点击右上角「···」即可转发至朋友圈</p>
      </div>
    </div>
  </div>
</div>

<style>
  .wechat-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    z-index: 1300;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .wechat-modal-overlay.active {
    display: flex !important;
    opacity: 1;
    pointer-events: auto;
  }
  .wechat-modal-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    animation: modalPop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modalPop {
    from { transform: scale(0.92) translateY(8px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }
  .wechat-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-color);
  }
  .header-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wechat-header-icon {
    color: #07c160;
  }
  .modal-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  .close-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .close-btn:hover {
    color: var(--text-primary);
  }
  .wechat-modal-body {
    padding: 28px 20px 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .qr-canvas-box {
    background: #ffffff;
    padding: 12px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }
  #wechat-qr-canvas {
    width: 180px;
    height: 180px;
    display: block;
  }
  .wechat-instructions {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .instruction-main {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  .instruction-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }
</style>

<script>
  import QRCode from 'qrcode';

  function closeWeChatModal() {
    const modal = document.getElementById('wechat-modal');
    if (modal) modal.classList.remove('active');
  }

  (window as any).openWeChatShareModal = async function(url: string) {
    const modal = document.getElementById('wechat-modal');
    const canvas = document.getElementById('wechat-qr-canvas') as HTMLCanvasElement;
    if (!modal || !canvas) return;

    modal.classList.add('active');

    try {
      await QRCode.toCanvas(canvas, url, {
        width: 360,
        margin: 1,
        errorCorrectionLevel: 'M',
        color: {
          dark: '#000000',
          light: '#ffffff'
        }
      });
    } catch (err) {
      console.error('Failed to generate WeChat QR Code', err);
    }
  };

  document.getElementById('close-wechat-btn')?.addEventListener('click', closeWeChatModal);
  document.getElementById('wechat-modal')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'wechat-modal') closeWeChatModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeWeChatModal();
  });
</script>
