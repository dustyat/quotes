---
const currentPath = Astro.url.pathname;
---

<nav class="bottom-nav-bar" aria-label="移动端底部快捷导航">
  <a href="/" class:list={['b-nav-item', { active: currentPath === '/' }]} aria-label="语录首页">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span>语录</span>
  </a>

  <a href="/tags" class:list={['b-nav-item', { active: currentPath.startsWith('/tags') }]} aria-label="话题分类">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
      <path d="M7 7h.01"></path>
    </svg>
    <span>话题</span>
  </a>

  <button id="mobile-search-btn" class="b-nav-item" aria-label="搜索金句">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>搜索</span>
  </button>

  <a href="/about" class:list={['b-nav-item', { active: currentPath === '/about' }]} aria-label="关于本站">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
    <span>关于</span>
  </a>
</nav>

<style>
  .bottom-nav-bar {
    display: none;
  }

  @media (max-width: 640px) {
    .bottom-nav-bar {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100vw;
      height: calc(54px + env(safe-area-inset-bottom, 0px));
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--bg-glass);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--border-color);
      z-index: 900;
      align-items: center;
      justify-content: space-around;
      box-shadow: var(--shadow-md);
    }
  }

  .b-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 500;
    flex: 1;
    height: 100%;
    transition: color 0.15s ease;
  }
  .b-nav-item:hover,
  .b-nav-item.active {
    color: var(--accent);
  }
</style>

<script is:inline>
  document.getElementById('mobile-search-btn')?.addEventListener('click', () => {
    if (typeof window.openSearchModal === 'function') {
      window.openSearchModal();
    }
  });
</script>
