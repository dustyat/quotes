---
import { SITE_CONFIG } from '@/utils/config';
import { formatFullDate, formatRelativeTime } from '@/utils/date';

interface Props {
  memos: any[];
  isFirst?: boolean;
}

const { memos, isFirst = true } = Astro.props;

// 预处理用于客户端随机轮播的数据
const quotesData = memos.map((memo) => {
  const memoId = memo.id.replace(/\.md$/, '');
  const cleanBody = (memo.body || '').replace(/[*#`_]/g, '').trim();
  const plainText = (memo.body || '').replace(/[\n#*`_]/g, ' ').trim();
  
  // 简易 Markdown 转 HTML（段落与加粗）
  const html = (memo.body || '')
    .trim()
    .split(/\n\n+/)
    .map((p: string) => `<p>${p.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</p>`)
    .join('');

  const sourcePart = memo.data.source ? `\n\n—— ${memo.data.source}` : '';
  const tweetText = `“${plainText.slice(0, 110)}${plainText.length > 110 ? '...' : ''}”${sourcePart}\n\n— via ${SITE_CONFIG.title}`;
  const memoPath = `/memo/${memoId}`;
  const defaultShareUrl = `${SITE_CONFIG.siteUrl}${memoPath}`;

  return {
    id: memoId,
    html,
    cleanBody,
    plainText,
    tweetText,
    source: memo.data.source || '',
    mood: memo.data.mood || '💡',
    date: memo.data.date.toISOString(),
    formattedDate: formatFullDate(memo.data.date),
    relativeTime: formatRelativeTime(memo.data.date),
    url: memoPath,
    twitterUrl: `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(defaultShareUrl)}`,
  };
});

// 默认首篇渲染（保证无 JS 时的首屏速度与 SEO）
const initial = quotesData[0] || null;
---

{initial && (
  <div class:list={['timeline-row', 'random-featured-row', { 'is-first': isFirst }]} id="random-featured-row">
    <!-- 左侧：文字“随机卡片” -->
    <div class="timeline-time">
      <span class="random-side-badge">随机卡片</span>
    </div>

    <!-- 中间：时间轴轨道与骰子心情节点 -->
    <div class="timeline-track">
      <div class="track-line"></div>
      <div class="track-node" title="随机卡片">
        <span class="node-mood random-dice-node" id="random-dice-trigger" title="点击也可随机换一条">🎲</span>
      </div>
    </div>

    <!-- 右侧：金句卡片主体（与普通卡片完全一致的排列与尺寸） -->
    <article class="quote-card random-quote-card">
      <!-- 顶部右侧：换一换操作按钮 -->
      <div class="card-header random-card-header">
        <button id="shuffle-btn" class="shuffle-action-btn" title="换一条精选金句" aria-label="换一条精选金句">
          <svg class="shuffle-spin-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
            <path d="M8 16H3v5"/>
          </svg>
          <span>换一换</span>
        </button>
      </div>

      <!-- 正文内容区 -->
      <div class="quote-main">
        <div class="quote-content-wrapper" id="random-quote-wrapper">
          <div class="quote-body" id="random-quote-body" set:html={initial.html}></div>

          <div class="quote-source" id="random-quote-source" style={initial.source ? '' : 'display: none;'}>
            <span class="source-dash">——</span>
            <span class="source-text" id="random-source-text">{initial.source}</span>
          </div>
        </div>
      </div>

      <!-- 底部操作栏 -->
      <div class="card-footer">
        <div class="footer-actions-left">
          <!-- 生成海报 -->
          <button 
            class="action-btn poster-btn" 
            id="random-poster-btn"
            data-content={initial.cleanBody} 
            data-source={initial.source} 
            data-date={initial.formattedDate}
            data-id={initial.id}
            title="生成金句海报"
            aria-label="生成金句海报"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
            </svg>
          </button>

          <!-- 复制纯文本 -->
          <button 
            class="action-btn copy-btn" 
            id="random-copy-btn"
            data-text={initial.cleanBody} 
            title="复制金句"
            aria-label="复制金句"
          >
            <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
          </button>
        </div>

        <div class="footer-actions-right">
          <!-- Twitter / X 分享 -->
          <a 
            id="random-twitter-link" 
            href={initial.twitterUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="icon-link twitter-link" 
            data-text={initial.tweetText}
            data-path={initial.url}
            title="分享到 X (Twitter)"
            aria-label="分享到 X (Twitter)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>

          <!-- Facebook 分享 -->
          <a 
            id="random-facebook-link"
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(SITE_CONFIG.siteUrl + initial.url)}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="icon-link facebook-link" 
            data-path={initial.url}
            title="分享到 Facebook"
            aria-label="分享到 Facebook"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- 微信朋友圈分享 -->
          <button 
            id="random-wechat-btn"
            class="icon-link wechat-link" 
            data-path={initial.url}
            data-title={initial.cleanBody.slice(0, 60)}
            title="分享到微信朋友圈"
            aria-label="分享到微信朋友圈"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.691 2.188C3.891 2.188 0 5.478 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.294.295a.34.34 0 0 0 .171-.05l1.92-1.077a.71.71 0 0 1 .59-.064c1.026.31 2.146.48 3.327.48.337 0 .668-.018.995-.045-.213-.655-.333-1.353-.333-2.08 0-4.047 3.864-7.332 8.655-7.332.32 0 .633.018.944.043C16.892 4.417 13.088 2.188 8.69 2.188zm-2.48 4.22c.62 0 1.12.5 1.12 1.119 0 .62-.5 1.12-1.12 1.12-.619 0-1.12-.5-1.12-1.12 0-.619.501-1.12 1.12-1.12zm5.58 0c.619 0 1.12.5 1.12 1.119 0 .62-.501 1.12-1.12 1.12-.62 0-1.12-.5-1.12-1.12 0-.619.5-1.12 1.12-1.12zm5.271 4.544c-3.992 0-7.243 2.742-7.243 6.126 0 3.383 3.251 6.125 7.243 6.125.857 0 1.677-.128 2.434-.36a.6.6 0 0 1 .5.053l1.602.9a.28.28 0 0 0 .143.042c.137 0 .245-.11.245-.246 0-.06-.024-.12-.04-.177l-.326-1.236a.49.49 0 0 1 .178-.555c1.528-1.124 2.508-2.784 2.508-4.63 0-3.384-3.251-6.126-7.244-6.126zm-2.07 3.518c.516 0 .933.417.933.933s-.417.933-.933.933c-.515 0-.933-.417-.933-.933s.418-.933.933-.933zm4.653 0c.516 0 .933.417.933.933s-.417.933-.933.933c-.516 0-.933-.417-.933-.933s.417-.933.933-.933z"/>
            </svg>
          </button>

          <!-- 复制原文链接 -->
          <button 
            id="random-copy-link-btn"
            class="icon-link copy-link-btn" 
            data-path={initial.url} 
            title="复制原文链接" 
            aria-label="复制原文链接"
          >
            <svg class="link-normal-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <svg class="link-copied-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </article>
  </div>
)}

<script id="random-quotes-data" type="application/json" set:html={JSON.stringify(quotesData)}></script>

<!-- 客户端随机与换一换交互逻辑 -->
<script is:inline>
  (function() {
    const dataEl = document.getElementById('random-quotes-data');
    if (!dataEl) return;
    let quotesData = [];
    try {
      quotesData = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
      return;
    }
    if (!quotesData || quotesData.length === 0) return;

    let currentIndex = 0;
    const wrapper = document.getElementById('random-quote-wrapper');
    const bodyEl = document.getElementById('random-quote-body');
    const sourceEl = document.getElementById('random-quote-source');
    const sourceTextEl = document.getElementById('random-source-text');
    const shuffleBtn = document.getElementById('shuffle-btn');
    const diceNode = document.getElementById('random-dice-trigger');
    const posterBtn = document.getElementById('random-poster-btn');
    const copyBtn = document.getElementById('random-copy-btn');
    const twitterLink = document.getElementById('random-twitter-link');
    const facebookLink = document.getElementById('random-facebook-link');
    const wechatBtn = document.getElementById('random-wechat-btn');
    const copyLinkBtn = document.getElementById('random-copy-link-btn');

    function renderQuote(index, animated = true) {
      const q = quotesData[index];
      if (!q) return;
      currentIndex = index;

      const updateDom = () => {
        if (bodyEl) bodyEl.innerHTML = q.html;
        if (sourceEl && sourceTextEl) {
          if (q.source) {
            sourceTextEl.textContent = q.source;
            sourceEl.style.display = '';
          } else {
            sourceEl.style.display = 'none';
          }
        }

        // 更新海报、复制与外链数据
        if (posterBtn) {
          posterBtn.setAttribute('data-content', q.cleanBody);
          posterBtn.setAttribute('data-source', q.source);
          posterBtn.setAttribute('data-date', q.formattedDate);
          posterBtn.setAttribute('data-id', q.id);
        }

        if (copyBtn) {
          copyBtn.setAttribute('data-text', q.cleanBody);
        }

        const origin = typeof window !== 'undefined' ? window.location.origin : SITE_CONFIG.siteUrl;

        if (twitterLink) {
          twitterLink.setAttribute('data-text', q.tweetText);
          twitterLink.setAttribute('data-path', q.url);
          twitterLink.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(q.tweetText)}&url=${encodeURIComponent(origin + q.url)}`;
        }

        if (facebookLink) {
          facebookLink.setAttribute('data-path', q.url);
          facebookLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(origin + q.url)}`;
        }

        if (wechatBtn) {
          wechatBtn.setAttribute('data-path', q.url);
          wechatBtn.setAttribute('data-title', q.cleanBody.slice(0, 60));
        }

        if (copyLinkBtn) {
          copyLinkBtn.setAttribute('data-path', q.url);
        }
      };

      if (animated && wrapper) {
        wrapper.classList.add('is-switching');
        setTimeout(() => {
          updateDom();
          wrapper.classList.remove('is-switching');
        }, 180);
      } else {
        updateDom();
      }
    }

    function doShuffle() {
      // 图标与骰子旋转微动效
      if (shuffleBtn) {
        const spinIcon = shuffleBtn.querySelector('.shuffle-spin-icon');
        if (spinIcon) {
          spinIcon.classList.add('spin-once');
          setTimeout(() => spinIcon.classList.remove('spin-once'), 600);
        }
      }
      if (diceNode) {
        diceNode.classList.add('dice-roll');
        setTimeout(() => diceNode.classList.remove('dice-roll'), 600);
      }

      // 抽取不同于当前的一篇
      let nextIndex;
      if (quotesData.length > 1) {
        do {
          nextIndex = Math.floor(Math.random() * quotesData.length);
        } while (nextIndex === currentIndex);
      } else {
        nextIndex = 0;
      }

      renderQuote(nextIndex, true);
    }

    // 页面初次加载时随机挑一条
    const initialRandomIndex = Math.floor(Math.random() * quotesData.length);
    renderQuote(initialRandomIndex, false);

    // 点击“换一换”按钮或点击左侧骰子
    if (shuffleBtn) shuffleBtn.addEventListener('click', doShuffle);
    if (diceNode) diceNode.addEventListener('click', doShuffle);
  })();
</script>

<style>
  /* 继承与对齐时间轴布局 */
  .timeline-row {
    display: flex;
    align-items: stretch;
    position: relative;
    margin-bottom: 28px;
  }

  /* 左侧标签：“随机卡片” */
  .timeline-time {
    width: 76px;
    margin-top: 20px;
    text-align: right;
    flex-shrink: 0;
  }

  .random-side-badge {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
    background: transparent;
    padding: 0;
    border-radius: 0;
    border: none;
    white-space: nowrap;
    letter-spacing: 0.02em;
    display: inline-block;
  }

  [data-theme="dark"] .random-side-badge {
    color: var(--text-primary);
    background: transparent;
    border-color: transparent;
  }

  /* 中间时间轴轨道 */
  .timeline-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    margin: 0 24px 0 12px;
    flex-shrink: 0;
    position: relative;
  }

  .track-line {
    position: absolute;
    top: 0;
    bottom: -28px;
    width: 2px;
    background: var(--border-color);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .timeline-row.is-first .track-line {
    top: 22px;
  }

  .track-node {
    position: relative;
    z-index: 2;
    margin-top: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    padding: 2px;
  }

  .node-mood {
    font-size: 1.25rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .node-mood:hover {
    transform: scale(1.3) rotate(15deg);
  }

  .dice-roll {
    animation: diceShake 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes diceShake {
    0% { transform: scale(1) rotate(0deg); }
    25% { transform: scale(1.3) rotate(-25deg); }
    50% { transform: scale(1.3) rotate(25deg); }
    75% { transform: scale(1.2) rotate(-10deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  /* 右侧卡片主体：极简现代无外框无背景 */
  .quote-card {
    flex: 1;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0 0 24px 0;
    box-shadow: none;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .quote-card:hover {
    border-color: transparent;
    box-shadow: none;
    background: transparent;
    transform: none;
  }

  /* 顶部换一换行 */
  .random-card-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 8px;
  }

  .shuffle-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .shuffle-action-btn:hover {
    color: var(--text-primary);
    border-color: transparent;
    background: transparent;
  }

  .shuffle-spin-icon {
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .spin-once {
    transform: rotate(360deg);
  }

  /* 正文区：无内衬外框与背景，纯净通透排版 */
  .quote-main {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0 0 10px 0;
    margin-bottom: 0;
    transition: none;
    box-shadow: none;
  }

  .timeline-row:hover .quote-main {
    border-color: transparent;
    box-shadow: none;
  }

  .quote-content-wrapper {
    transition: opacity 0.18s ease, transform 0.18s ease;
    will-change: opacity, transform;
  }

  .quote-content-wrapper.is-switching {
    opacity: 0;
    transform: translateY(4px);
  }

  .quote-body {
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--text-primary);
    word-break: break-word;
    font-weight: 400;
  }

  .quote-body :global(p) {
    margin: 0 0 12px 0;
  }

  .quote-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .quote-body :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .quote-source {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .source-dash {
    opacity: 0.6;
  }

  /* 底部操作栏：极简纯图标与无框设计 */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
  }

  .footer-actions-left,
  .footer-actions-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .action-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .action-btn:hover {
    background: transparent;
    color: var(--text-primary);
    transform: scale(1.15);
  }

  .poster-btn:hover,
  .copy-btn:hover {
    color: var(--text-primary);
    background: transparent;
    border-color: transparent;
  }

  .icon-link {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: transparent;
    border: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .icon-link:hover {
    background: transparent;
    color: var(--text-primary);
    transform: scale(1.15);
  }

  .twitter-link:hover {
    color: var(--text-primary);
    background: transparent;
  }
  .facebook-link:hover {
    color: #1877f2;
    background: transparent;
  }
  .wechat-link:hover {
    color: #07c160;
    background: transparent;
  }
  .copy-link-btn:hover {
    color: var(--text-primary);
    background: transparent;
  }
  .copy-link-btn.copied {
    color: #07c160;
  }
  .copy-link-btn.copied .link-normal-icon {
    display: none !important;
  }
  .copy-link-btn.copied .link-copied-icon {
    display: inline-block !important;
  }

  @media (max-width: 640px) {
    .timeline-row {
      margin-bottom: 20px;
    }
    .timeline-time {
      width: 66px;
      margin-top: 17px;
    }
    .random-side-badge {
      font-size: 0.75rem;
    }
    .timeline-track {
      width: 18px;
      margin: 0 10px 0 4px;
    }
    .node-mood {
      font-size: 1rem;
    }
    .quote-card {
      padding: 0 0 18px 0;
    }
    .quote-main {
      padding: 0 0 10px 0;
