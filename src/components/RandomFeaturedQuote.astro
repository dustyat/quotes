---
import { SITE_CONFIG } from '@/utils/config';
import { formatFullDate } from '@/utils/date';
import { DEFAULT_LOCALE, type Locale, LOCALES, useTranslations, formatLocalizedRelativeTime } from '@/i18n/ui';

interface Props {
  memos: any[];
  isFirst?: boolean;
  locale?: Locale;
}

const { memos, isFirst = true, locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
const langPrefix = LOCALES[locale]?.prefix || '';

// 预处理用于客户端随机轮播的数据
const quotesData = memos.map((memo) => {
  const memoId = memo.id.replace(/\.md$/, '');
  const translations = memo.data.translations || {};

  const displayContent = (locale !== DEFAULT_LOCALE && translations[locale]?.content)
    ? translations[locale].content
    : (memo.body || '');

  const displaySource = (locale !== DEFAULT_LOCALE && translations[locale]?.source)
    ? translations[locale].source
    : (memo.data.source || '');

  const cleanBody = displayContent.replace(/[*#`_]/g, '').trim();
  const plainText = displayContent.replace(/[\n#*`_]/g, ' ').trim();
  
  // 简易 Markdown 转 HTML（段落与加粗）
  const html = displayContent
    .trim()
    .split(/\n\n+/)
    .map((p: string) => `<p>${p.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')}</p>`)
    .join('');

  const sourcePart = displaySource ? `\n\n—— ${displaySource}` : '';
  const tweetText = `“${plainText.slice(0, 110)}${plainText.length > 110 ? '...' : ''}”${sourcePart}\n\n— via ${SITE_CONFIG.title}`;
  const memoPath = `${langPrefix}/memo/${memoId}`;
  const defaultShareUrl = `${SITE_CONFIG.siteUrl}${memoPath}`;
  const memoDate = memo.data.date ? new Date(memo.data.date) : new Date();

  return {
    id: memoId,
    html,
    cleanBody,
    plainText,
    tweetText,
    source: displaySource,
    mood: memo.data.mood || '💡',
    date: memoDate.toISOString(),
    formattedDate: formatFullDate(memoDate),
    relativeTime: formatLocalizedRelativeTime(memoDate, locale),
    url: memoPath,
    twitterUrl: `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(defaultShareUrl)}`,
    translations,
  };
});

// 默认首篇渲染（保证无 JS 时的首屏速度与 SEO）
const initial = quotesData[0] || null;
---

{initial && (
  <div class:list={['timeline-row', 'random-featured-row', { 'is-first': isFirst }]} id="random-featured-row">
    <!-- 左侧：文字“随机卡片” -->
    <div class="timeline-time">
      <span class="random-side-badge">{t('feed.random')}</span>
    </div>

    <!-- 中间：时间轴轨道与骰子心情节点 -->
    <div class="timeline-track">
      <div class="track-line"></div>
      <div class="track-node" title={t('feed.random')}>
        <span class="node-mood random-dice-node" id="random-dice-trigger" title="点击也可随机换一条">🎲</span>
      </div>
    </div>

    <!-- 右侧：金句卡片主体（与普通卡片完全一致的排列与尺寸） -->
    <article class="quote-card random-quote-card">
      <!-- 顶部右侧：换一换操作按钮 -->
      <div class="card-header random-card-header">
        <button id="shuffle-btn" class="shuffle-action-btn" title={t('feed.shuffle')} aria-label={t('feed.shuffle')}>
          <svg class="shuffle-spin-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
            <path d="M8 16H3v5"/>
          </svg>
          <span>{t('feed.shuffle')}</span>
        </button>
      </div>

      <!-- 正文内容区 -->
      <div class="quote-main">
        <div class="quote-content-wrapper" id="random-quote-wrapper">
          <div class="quote-body" id="random-quote-body" set:html={initial.html}></div>

          <div class="quote-source" id="random-quote-source" style={initial.source ? '' : 'display: none;'}>
            <span class="source-dash">——</span>
            <span class="source-text" id="random-source-text">{initial.source}</span>
          </div>
        </div>
      </div>

      <!-- 底部操作栏 -->
      <div class="card-footer">
        <div class="footer-actions-left">
          <!-- 生成海报 -->
          <button 
            class="action-btn poster-btn" 
            id="random-poster-btn"
            data-content={initial.cleanBody} 
            data-source={initial.source} 
            data-date={initial.formattedDate}
            data-id={initial.id}
            data-cur-lang={locale}
            data-translations={JSON.stringify(initial.translations || {})}
            title={t('action.poster')}
            aria-label={t('action.poster')}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
            </svg>
          </button>

          <!-- 复制纯文本 -->
          <button 
            class="action-btn copy-btn" 
            id="random-copy-btn"
            data-text={initial.cleanBody} 
            title={t('action.copy')}
            aria-label={t('action.copy')}
          >
            <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
          </button>
        </div>

        <div class="footer-actions-right">
          <!-- Twitter / X 分享 -->
          <a 
            id="random-twitter-link" 
            href={initial.twitterUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="icon-link twitter-link" 
            data-text={initial.tweetText}
            data-path={initial.url}
            title="分享到 X (Twitter)"
            aria-label="分享到 X (Twitter)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>

          <!-- Facebook 分享 -->
          <a 
            id="random-facebook-link"
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(SITE_CONFIG.siteUrl + initial.url)}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="icon-link facebook-link" 
            data-path={initial.url}
            title="分享到 Facebook"
            aria-label="分享到 Facebook"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>

          <!-- 通用分享 (移动端呼起原生系统分享，PC端复制原文链接) -->
          <button 
            id="random-share-btn"
            class="icon-link share-link-btn" 
            data-path={initial.url} 
            data-title={initial.cleanBody.slice(0, 60)}
            title="分享 / 复制链接" 
            aria-label="分享 / 复制链接"
          >
            <svg class="share-normal-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <svg class="share-copied-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </article>
  </div>
)}

<script id="random-quotes-data" type="application/json" set:html={JSON.stringify(quotesData)}></script>

<!-- 客户端随机与换一换交互逻辑 -->
<script is:inline>
  (function() {
    const dataEl = document.getElementById('random-quotes-data');
    if (!dataEl) return;
    let quotesData = [];
    try {
      quotesData = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
      return;
    }
    if (!quotesData || quotesData.length === 0) return;

    let currentIndex = 0;
    const wrapper = document.getElementById('random-quote-wrapper');
    const bodyEl = document.getElementById('random-quote-body');
    const sourceEl = document.getElementById('random-quote-source');
    const sourceTextEl = document.getElementById('random-source-text');
    const shuffleBtn = document.getElementById('shuffle-btn');
    const diceNode = document.getElementById('random-dice-trigger');
    const posterBtn = document.getElementById('random-poster-btn');
    const copyBtn = document.getElementById('random-copy-btn');
    const twitterLink = document.getElementById('random-twitter-link');
    const facebookLink = document.getElementById('random-facebook-link');
    const shareBtn = document.getElementById('random-share-btn');

    function renderQuote(index, animated = true) {
      const q = quotesData[index];
      if (!q) return;
      currentIndex = index;

      const updateDom = () => {
        if (bodyEl) bodyEl.innerHTML = q.html;
        if (sourceEl && sourceTextEl) {
          if (q.source) {
            sourceTextEl.textContent = q.source;
            sourceEl.style.display = '';
          } else {
            sourceEl.style.display = 'none';
          }
        }

        // 更新海报、复制与外链数据
        if (posterBtn) {
          posterBtn.setAttribute('data-content', q.cleanBody);
          posterBtn.setAttribute('data-source', q.source);
          posterBtn.setAttribute('data-date', q.formattedDate);
          posterBtn.setAttribute('data-id', q.id);
          posterBtn.setAttribute('data-cur-lang', '${locale}');
          posterBtn.setAttribute('data-translations', JSON.stringify(q.translations || {}));
        }

        if (copyBtn) {
          copyBtn.setAttribute('data-text', q.cleanBody);
        }

        const origin = typeof window !== 'undefined' ? window.location.origin : SITE_CONFIG.siteUrl;

        if (twitterLink) {
          twitterLink.setAttribute('data-text', q.tweetText);
          twitterLink.setAttribute('data-path', q.url);
          twitterLink.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(q.tweetText)}&url=${encodeURIComponent(origin + q.url)}`;
        }

        if (facebookLink) {
          facebookLink.setAttribute('data-path', q.url);
          facebookLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(origin + q.url)}`;
        }

        if (shareBtn) {
          shareBtn.setAttribute('data-path', q.url);
          shareBtn.setAttribute('data-title', q.cleanBody.slice(0, 60));
        }
      };

      if (animated && wrapper) {
        wrapper.classList.add('is-switching');
        setTimeout(() => {
          updateDom();
          wrapper.classList.remove('is-switching');
        }, 180);
      } else {
        updateDom();
      }
    }

    function doShuffle() {
      // 图标与骰子旋转微动效
      if (shuffleBtn) {
        const spinIcon = shuffleBtn.querySelector('.shuffle-spin-icon');
        if (spinIcon) {
          spinIcon.classList.add('spin-once');
          setTimeout(() => spinIcon.classList.remove('spin-once'), 600);
        }
      }
      if (diceNode) {
        diceNode.classList.add('dice-roll');
        setTimeout(() => diceNode.classList.remove('dice-roll'), 600);
      }

      // 抽取不同于当前的一篇
      let nextIndex;
      if (quotesData.length > 1) {
        do {
          nextIndex = Math.floor(Math.random() * quotesData.length);
        } while (nextIndex === currentIndex);
      } else {
        nextIndex = 0;
      }

      renderQuote(nextIndex, true);
    }

    // 页面初次加载时随机挑一条
    const initialRandomIndex = Math.floor(Math.random() * quotesData.length);
    renderQuote(initialRandomIndex, false);

    // 点击“换一换”按钮或点击左侧骰子
    if (shuffleBtn) shuffleBtn.addEventListener('click', doShuffle);
    if (diceNode) diceNode.addEventListener('click', doShuffle);
  })();
</script>

<style>
  /* 继承与对齐时间轴布局 */
  .timeline-row {
    display: flex;
    align-items: stretch;
    position: relative;
    margin-bottom: 28px;
  }

  .random-featured-row {
    margin-top: 8px;
  }

  /* 左侧标签：“随机卡片” - 颜色与时间戳完全一致 */
  .timeline-time {
    width: 76px;
    margin-top: 7px;
    text-align: right;
    flex-shrink: 0;
  }

  .random-side-badge {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    padding: 0;
    border-radius: 0;
    border: none;
    white-space: nowrap;
    letter-spacing: 0.02em;
    display: inline-block;
  }

  /* 中间时间轴轨道：增加右侧间距远离卡片 */
  .timeline-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    margin: 0 36px 0 14px;
    flex-shrink: 0;
    position: relative;
  }

  /* 竖向轴线：1px 细线，淡雅低干扰 */
  .track-line {
    position: absolute;
    top: 0;
    bottom: -28px;
    width: 1px;
    background: var(--timeline-line);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .timeline-row.is-first .track-line {
    top: 16px;
  }

  /* 时间轴节点：与首行文字垂直对齐 */
  .track-node {
    position: relative;
    z-index: 2;
    margin-top: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    padding: 2px;
  }

  .node-mood {
    font-size: 1.25rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .node-mood:hover {
    transform: scale(1.3) rotate(15deg);
  }

  .dice-roll {
    animation: diceShake 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes diceShake {
    0% { transform: scale(1) rotate(0deg); }
    25% { transform: scale(1.3) rotate(-25deg); }
    50% { transform: scale(1.3) rotate(25deg); }
    75% { transform: scale(1.2) rotate(-10deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  /* 右侧卡片主体：极简现代无外框无背景 */
  .quote-card {
    flex: 1;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0 0 24px 0;
    box-shadow: none;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    min-width: 0;
    position: relative;
  }

  .quote-card:hover {
    border-color: transparent;
    box-shadow: none;
    background: transparent;
    transform: none;
  }

  /* 顶部换一换：上移一行位于右上角，完全不影响卡片文字排版 */
  .random-card-header {
    position: absolute;
    top: -26px;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 0;
  }

  .shuffle-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 0;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .shuffle-action-btn:hover {
    color: var(--text-primary);
    border-color: transparent;
    background: transparent;
  }

  .shuffle-spin-icon {
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .spin-once {
    transform: rotate(360deg);
  }

  /* 正文区：无内衬外框与背景，纯净通透排版 */
  .quote-main {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0 0 10px 0;
    margin-bottom: 0;
    transition: none;
    box-shadow: none;
  }

  .timeline-row:hover .quote-main {
    border-color: transparent;
    box-shadow: none;
  }

  .quote-content-wrapper {
    transition: opacity 0.18s ease, transform 0.18s ease;
    will-change: opacity, transform;
  }

  .quote-content-wrapper.is-switching {
    opacity: 0;
    transform: translateY(4px);
  }

  .quote-body {
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--text-primary);
    word-break: break-word;
    font-weight: 400;
  }

  .quote-body :global(p) {
    margin: 0 0 12px 0;
  }

  .quote-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .quote-body :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .quote-source {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .source-dash {
    opacity: 0.6;
  }

  /* 底部操作栏：极简纯图标与无框设计 */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
  }

  .footer-actions-left,
  .footer-actions-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .action-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .action-btn:hover {
    background: transparent;
    color: var(--text-primary);
    transform: scale(1.15);
  }

  .poster-btn:hover,
  .copy-btn:hover {
    color: var(--text-primary);
    background: transparent;
    border-color: transparent;
  }

  .icon-link {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: transparent;
    border: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .icon-link:hover {
    background: transparent;
    color: var(--text-primary);
    transform: scale(1.15);
  }

  .twitter-link:hover {
    color: var(--text-primary);
    background: transparent;
  }
  .facebook-link:hover {
    color: #1877f2;
    background: transparent;
  }
  .share-link-btn:hover {
    color: var(--text-primary);
    background: transparent;
  }
  .share-link-btn.copied {
    color: #07c160;
  }
  .share-link-btn.copied .share-normal-icon {
    display: none !important;
  }
  .share-link-btn.copied .share-copied-icon {
    display: inline-block !important;
  }

  @media (max-width: 640px) {
    .timeline-row {
      margin-bottom: 20px;
    }
    .timeline-time {
      width: 66px;
      margin-top: 5px;
    }
    .random-side-badge {
      font-size: 0.75rem;
    }
    .timeline-track {
      width: 18px;
      margin: 0 18px 0 6px;
    }
    .track-node {
      margin-top: 4px;
    }
    .node-mood {
      font-size: 1rem;
    }
    .random-card-header {
      top: -24px;
    }
    .quote-card {
      padding: 0 0 18px 0;
    }
    .quote-main {
      padding: 0 0 10px 0;
    }
    .quote-body {
      font-size: 1.0625rem;
      line-height: 1.7;
    }
    .footer-actions-right {
      gap: 5px;
    }
    .action-btn,
    .icon-link {
      width: 28px;
      height: 28px;
    }
  }
</style>
