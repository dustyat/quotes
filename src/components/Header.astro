---
import ThemeToggle from './ThemeToggle.astro';

// 规范化当前路径，去除尾部斜杠确保路由匹配一致
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="top-nav-bar">
  <div class="nav-container">
    <!-- Left: Navigation Menu Links -->
    <nav class="nav-menu">
      <a href="/" class:list={['menu-item', { active: pathname === '/' }]}>语录</a>
      <a href="/tags" class:list={['menu-item', { active: pathname === '/tags' || pathname.startsWith('/tags/') }]}>话题</a>
      <a href="/about" class:list={['menu-item', { active: pathname === '/about' || pathname.startsWith('/about/') }]}>关于</a>
    </nav>

    <!-- Center: Transparent Logo (亮色黑色，暗色白色) -->
    <a href="/" class="nav-center-logo" aria-label="Quotes 首页" title="Quotes">
      <svg class="center-logo-svg" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
        <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/>
      </svg>
    </a>

    <!-- Right: Action Icons -->
    <div class="tool-icons">
      <button id="header-search-btn" class="tool-btn" aria-label="搜索金句" title="搜索 (⌘K)">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .top-nav-bar {
    position: sticky;
    top: 0;
    z-index: 500;
    width: 100%;
    background: var(--bg-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
  }

  .nav-container {
    max-width: 760px;
    height: 56px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    position: relative;
  }

  .nav-center-logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    text-decoration: none;
    padding: 6px;
    border-radius: var(--radius-full);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-center-logo:hover {
    transform: translateX(-50%) scale(1.15);
  }

  .center-logo-svg {
    display: block;
    color: #0f172a;
    transition: color 0.2s ease;
  }

  :global([data-theme="dark"]) .center-logo-svg {
    color: #f4f4f5;
  }

  .nav-center-logo:hover .center-logo-svg {
    color: var(--text-primary);
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-item {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 6px 0;
    border-radius: 0;
    transition: color 0.15s ease;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    background: transparent;
  }
  .menu-item:hover {
    color: var(--text-primary);
    background: transparent;
  }
  .menu-item.active {
    color: var(--text-primary);
    font-weight: 700;
    background: transparent;
  }

  .tool-icons {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    margin: 0;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    background: transparent;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .tool-btn:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .nav-container {
      padding: 0 14px;
    }
    .menu-item {
      padding: 6px 8px;
      font-size: 0.8125rem;
    }
  }
</style>

<script is:inline>
  document.getElementById('header-search-btn')?.addEventListener('click', () => {
    if (typeof window.openSearchModal === 'function') {
      window.openSearchModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (typeof window.openSearchModal === 'function') {
        window.openSearchModal();
      }
    }
  });
</script>
