---
---

<div id="poster-modal" class="poster-modal-overlay" aria-hidden="true">
  <div class="poster-modal-container">
    <div class="poster-modal-header">
      <h3 class="modal-title">生成金句海报</h3>
      <button id="close-poster-btn" class="close-btn" aria-label="关闭">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="poster-preview-wrapper">
      <canvas id="poster-canvas" width="800" height="1000"></canvas>
    </div>

    <div class="poster-modal-actions">
      <button id="download-poster-btn" class="action-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>保存高清海报</span>
      </button>
      <button id="copy-poster-btn" class="action-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
        <span>复制图片</span>
      </button>
    </div>
  </div>
</div>

<style>
  .poster-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: 1200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .poster-modal-overlay.active {
    display: flex !important;
    opacity: 1;
    pointer-events: auto;
  }
  .poster-modal-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 460px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modalPop {
    from { transform: scale(0.92) translateY(10px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }
  .poster-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-color);
  }
  .modal-title {
    font-size: 1rem;
    font-weight: 600;
  }
  .close-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }
  .close-btn:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }
  .poster-preview-wrapper {
    flex: 1;
    padding: 24px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    background: var(--bg-primary);
  }
  #poster-canvas {
    width: 100%;
    max-width: 360px;
    height: auto;
    border-radius: 4px;
    box-shadow: none;
    border: none;
  }
  .poster-modal-actions {
    display: flex;
    justify-content: center;
    gap: 32px;
    padding: 16px 20px;
    border-top: 1px solid var(--border-color);
    background: transparent;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 38px;
    padding: 0 4px;
    border-radius: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .action-btn:hover {
    opacity: 0.7;
    transform: scale(1.04);
    background: transparent;
  }
</style>

<script>
  import QRCode from 'qrcode';

  let currentQuoteData: any = null;

  (window as any).openPosterModal = async function(data: any) {
    currentQuoteData = data;
    const modal = document.getElementById('poster-modal');
    if (!modal) return;
    modal.classList.add('active');
    await renderPosterCanvas(data);
  };

  function closePosterModal() {
    const modal = document.getElementById('poster-modal');
    if (modal) modal.classList.remove('active');
  }

  document.getElementById('close-poster-btn')?.addEventListener('click', closePosterModal);
  document.getElementById('poster-modal')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'poster-modal') closePosterModal();
  });

  async function renderPosterCanvas(data: any) {
    const canvas = document.getElementById('poster-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const width = 800;
    const height = 1000;
    canvas.width = width;
    canvas.height = height;

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

    // 背景绘制：纯粹极简底色
    ctx.fillStyle = isDark ? '#09090b' : '#ffffff';
    ctx.fillRect(0, 0, width, height);

    // 绘制顶部大引号（黑色/白色极简呈现）
    ctx.font = '900 76px "Noto Serif SC", Georgia, serif';
    ctx.fillStyle = isDark ? '#f4f4f5' : '#0f172a';
    ctx.fillText('“', 70, 140);

    // 绘制金句正文
    ctx.font = '500 34px -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif';
    ctx.fillStyle = isDark ? '#f4f4f5' : '#0f172a';
    
    const maxTextWidth = width - 160;
    const lineHeight = 58;
    const startX = 80;
    let startY = 220;

    const cleanText = (data.content || '').replace(/[*#`_]/g, '');
    const paragraphs = cleanText.split('\n');

    for (let p = 0; p < paragraphs.length; p++) {
      const paragraph = paragraphs[p].trim();
      if (!paragraph) {
        startY += lineHeight * 0.5;
        continue;
      }
      const chars = paragraph.split('');
      let line = '';
      for (let n = 0; n < chars.length; n++) {
        const testLine = line + chars[n];
        const metrics = ctx.measureText(testLine);
        if (metrics.width > maxTextWidth && n > 0) {
          ctx.fillText(line, startX, startY);
          line = chars[n];
          startY += lineHeight;
        } else {
          line = testLine;
        }
      }
      if (line) {
        ctx.fillText(line, startX, startY);
        startY += lineHeight;
      }
    }

    // 绘制来源 (Source) - 右对齐
    if (data.source) {
      startY += 32;
      ctx.font = 'italic 500 24px -apple-system, sans-serif';
      ctx.fillStyle = isDark ? '#a1a1aa' : '#71717a';
      ctx.textAlign = 'right';
      ctx.fillText(`—— ${data.source}`, width - 80, startY);
      ctx.textAlign = 'left';
    }

    // 绘制底部 Quotes 品牌与右侧极简纯色二维码
    const bottomY = height - 90;
    const dividerY = bottomY - 30;
    
    // 分割线
    ctx.beginPath();
    ctx.moveTo(80, dividerY);
    ctx.lineTo(width - 80, dividerY);
    ctx.strokeStyle = isDark ? '#27272a' : '#f1f5f9';
    ctx.lineWidth = 1;
    ctx.stroke();

    // 绘制右侧极简纯色二维码（暗黑下纯白微透，浅色下黑色极简，不带任何文字）
    const qrSize = 74;
    const qrX = width - 80 - qrSize;
    const qrY = dividerY + 16;
    const targetUrl = data.id 
      ? `${window.location.origin}/memo/${data.id}` 
      : (data.url || window.location.href);

    const qrDarkColor = isDark ? 'rgba(255, 255, 255, 0.85)' : '#09090b';

    try {
      const tempCanvas = document.createElement('canvas');
      await QRCode.toCanvas(tempCanvas, targetUrl, {
        width: qrSize * 3, // 高清 3x 保证清晰扫码
        margin: 0,
        errorCorrectionLevel: 'M',
        color: {
          dark: qrDarkColor,
          light: '#00000000' // 透明背景
        }
      });
      ctx.drawImage(tempCanvas, qrX, qrY, qrSize, qrSize);
    } catch (err) {
      console.error('Failed to render QR Code', err);
    }

    // 左侧保持 Quotes，不带域名和文字，极简，垂直与二维码居中对齐
    ctx.font = '800 28px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillStyle = isDark ? '#f4f4f5' : '#0f172a';
    ctx.textBaseline = 'middle';
    ctx.fillText('Quotes', 80, qrY + qrSize / 2);
    ctx.textBaseline = 'alphabetic';
  }

  // 下载图片
  document.getElementById('download-poster-btn')?.addEventListener('click', () => {
    const canvas = document.getElementById('poster-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const link = document.createElement('a');
    link.download = `quote-${Date.now()}.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
  });

  // 复制图片
  document.getElementById('copy-poster-btn')?.addEventListener('click', async () => {
    const canvas = document.getElementById('poster-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    try {
      canvas.toBlob(async (blob) => {
        if (!blob) return;
        await navigator.clipboard.write([
          new ClipboardItem({ 'image/png': blob })
        ]);
        alert('海报已复制到剪贴板！');
      });
    } catch (err) {
      alert('浏览器暂不支持直接复制图片，请使用“保存高清海报”');
    }
  });
</script>
